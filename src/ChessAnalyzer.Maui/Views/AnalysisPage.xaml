<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessAnalyzer.Maui.ViewModels"
             xmlns:models="clr-namespace:ChessAnalyzer.Core.Models;assembly=ChessAnalyzer.Core"
             x:Class="ChessAnalyzer.Maui.Views.AnalysisPage"
             x:DataType="vm:AnalysisViewModel"
             Title="Анализ партии"
             BackgroundColor="{StaticResource BgDark}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding Game.White, StringFormat='{0} vs {1}'}"
                   FontSize="20"
                   TextColor="White"
                   FontAttributes="Bold" />
            <Label Text="{Binding Game.Black}" IsVisible="False" />
            <Label Text="{Binding Game.Result, StringFormat='Результат: {0}'}"
                   TextColor="#AAA" />

            <Button Text="Анализировать (Stockfish)"
                    Command="{Binding AnalyzeCommand}"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource AccentGreen}"
                    TextColor="Black" />

            <ActivityIndicator IsRunning="{Binding IsAnalyzing}"
                               IsVisible="{Binding IsAnalyzing}"
                               Color="{StaticResource AccentGreen}" />
            <Label Text="{Binding ProgressText}" TextColor="#888" />

            <Grid IsVisible="{Binding Result, Converter={StaticResource IsNotNullConverter}}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="8">
                <Border Padding="12" BackgroundColor="#2A2A2A">
                    <VerticalStackLayout>
                        <Label Text="Точность белых" TextColor="#888" />
                        <Label Text="{Binding Result.WhiteAccuracy, StringFormat='{0}%'}"
                               FontSize="28"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="12" BackgroundColor="#2A2A2A">
                    <VerticalStackLayout>
                        <Label Text="Точность чёрных" TextColor="#888" />
                        <Label Text="{Binding Result.BlackAccuracy, StringFormat='{0}%'}"
                               FontSize="28"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding SelectedMove, Converter={StaticResource IsNotNullConverter}}"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <Button Text="◀" Command="{Binding PrevMoveCommand}" WidthRequest="48" />
                <Label Grid.Column="1"
                       Text="{Binding SelectedMove.San, StringFormat='Ход: {0}'}"
                       TextColor="White"
                       FontSize="18"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="▶" Command="{Binding NextMoveCommand}" WidthRequest="48" />
            </Grid>

            <Border IsVisible="{Binding SelectedMove, Converter={StaticResource IsNotNullConverter}}"
                    Padding="16"
                    BackgroundColor="#2A2A2A">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SelectedMove.Classification, Converter={StaticResource ClassificationConverter}}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{Binding SelectedMove.Classification, Converter={StaticResource ClassificationColorConverter}}" />
                    <Label Text="{Binding SelectedMove.BestMoveSan, StringFormat='Лучший ход: {0}'}"
                           TextColor="{StaticResource AccentGreen}" />
                    <Label Text="{Binding SelectedMove.CentipawnLoss, StringFormat='Потеря: {0} cp'}"
                           TextColor="#F0C15D" />
                    <Label Text="{Binding Result.AnalysisDuration, StringFormat='Время анализа: {0:mm\\:ss}'}"
                           TextColor="#666"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Result.Moves}"
                            HeightRequest="220"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedMove}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MoveAnalysis">
                        <Border Padding="8,6" BackgroundColor="#333" WidthRequest="72">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding San}"
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                                <BoxView HeightRequest="4"
                                         Color="{Binding Classification, Converter={StaticResource ClassificationColorConverter}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
