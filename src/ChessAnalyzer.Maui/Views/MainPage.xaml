<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:ChessAnalyzer.Shared;assembly=ChessAnalyzer.Shared"
             xmlns:b="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             x:Class="ChessAnalyzer.Maui.Views.MainPage"
             BackgroundColor="{StaticResource BgDark}">

    <b:BlazorWebView HostPage="wwwroot/index.html">
        <b:BlazorWebView.RootComponents>
            <b:RootComponent Selector="#app" ComponentType="{x:Type shared:App}" />
        </b:BlazorWebView.RootComponents>
    </b:BlazorWebView>
</ContentPage>
