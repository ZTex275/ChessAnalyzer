<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChessAnalyzer.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Chess Analyzer</ApplicationTitle>
    <ApplicationId>com.chessanalyzer.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.8</ApplicationDisplayVersion>
    <ApplicationVersion>9</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E1E1E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E1E1E" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="..\ChessAnalyzer.Shared\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessAnalyzer.Core\ChessAnalyzer.Core.csproj" />
    <ProjectReference Include="..\ChessAnalyzer.Shared\ChessAnalyzer.Shared.csproj" />
    <ProjectReference Include="..\ChessAnalyzer.Stockfish\ChessAnalyzer.Stockfish.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.40" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.40" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libstockfish.so" />
    <TrimmerRootAssembly Include="ChessAnalyzer.Shared" RootMode="All" />
    <TrimmerRootAssembly Include="ChessAnalyzer.Maui" RootMode="All" />
  </ItemGroup>

  <Target Name="PrepareAndroidStockfish"
          BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFramework)' == 'net9.0-android'">
    <PropertyGroup>
      <_StockfishSrc>$(MSBuildProjectDirectory)\engines\stockfish</_StockfishSrc>
      <_StockfishDstDir>$(MSBuildProjectDirectory)\Platforms\Android\lib\arm64-v8a</_StockfishDstDir>
      <_StockfishDst>$(_StockfishDstDir)\libstockfish.so</_StockfishDst>
    </PropertyGroup>
    <Error Condition="!Exists('$(_StockfishSrc)')"
           Text="Stockfish Android binary missing: engines\stockfish. Download stockfish-android-armv8 and place it there." />
    <MakeDir Directories="$(_StockfishDstDir)" />
    <Copy SourceFiles="$(_StockfishSrc)" DestinationFiles="$(_StockfishDst)" SkipUnchangedFiles="true" />
  </Target>

</Project>
