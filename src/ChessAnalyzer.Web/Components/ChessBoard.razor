@using ChessAnalyzer.Web.Components
@using ChessAnalyzer.Core.Chess

<div class="board-wrap">
    <div class="chess-board @(Flip ? "flipped" : "")">
        @foreach (var sq in Squares)
        {
            var fileIndex = sq.Square[0] - 'a';
            var rank = sq.Square[1] - '0';
            var isLight = (fileIndex + rank) % 2 == 0;
            var classes = "square " + (isLight ? "light" : "dark");

            if (Interactive && SelectedSquare == sq.Square)
                classes += " selected";

            if (Interactive && LegalTargets.Contains(sq.Square))
                classes += " legal";

            if (PlayedFrom == sq.Square || PlayedTo == sq.Square)
                classes += " played";

            if (BestFrom == sq.Square || BestTo == sq.Square)
                classes += " best";

            <div class="@classes" @onclick="() => HandleSquareClick(sq.Square)">
                @if (sq.Piece != '.')
                {
                    <span class="piece">@ChessBoardHelper.PieceSymbol(sq.Piece)</span>
                }
            </div>
        }
    </div>
    @if (ShowLegend)
    {
        <div class="board-legend">
            <span class="legend-item"><span class="dot played"></span> сыгранный</span>
            <span class="legend-item"><span class="dot best"></span> лучший</span>
        </div>
    }
</div>

@code {
    [Parameter] public string Fen { get; set; } = BoardState.StartFen;
    [Parameter] public bool Flip { get; set; }
    [Parameter] public string? PlayedUci { get; set; }
    [Parameter] public string? BestUci { get; set; }
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public string? SelectedSquare { get; set; }
    [Parameter] public IReadOnlyList<string> LegalTargets { get; set; } = [];
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public EventCallback<string> OnSquareClick { get; set; }

    private string? PlayedFrom { get; set; }
    private string? PlayedTo { get; set; }
    private string? BestFrom { get; set; }
    private string? BestTo { get; set; }
    private IReadOnlyList<(char Piece, string Square)> Squares { get; set; } = [];

    protected override void OnParametersSet()
    {
        var played = ChessBoardHelper.ParseUci(PlayedUci);
        PlayedFrom = played?.From;
        PlayedTo = played?.To;

        var best = ChessBoardHelper.ParseUci(BestUci);
        BestFrom = best?.From;
        BestTo = best?.To;

        Squares = ChessBoardHelper.ParseFen(Fen, Flip);
    }

    private async Task HandleSquareClick(string square)
    {
        if (!Interactive || !OnSquareClick.HasDelegate)
            return;

        await OnSquareClick.InvokeAsync(square);
    }
}
