@using ChessAnalyzer.Web.Components
@using ChessAnalyzer.Core.Chess
@using ChessAnalyzer.Core.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="board-wrap">
    <div class="board-with-coords">
        <div class="rank-labels">
            @for (var row = 0; row < 8; row++)
            {
                <span class="coord rank-coord">@ChessBoardHelper.RankLabel(row, Flip)</span>
            }
        </div>

        <div class="board-main">
            <div @ref="_boardRef"
                 class="chess-board"
                 data-interactive="@(Interactive ? "true" : "false")">
                @foreach (var sq in Squares)
                {
                    var isLight = ChessBoardHelper.IsLightSquare(sq.Square);
                    var classes = "square " + (isLight ? "light" : "dark");

                    if (Interactive && SelectedSquare == sq.Square)
                        classes += " selected";

                    if (Interactive && LegalTargets.Contains(sq.Square))
                        classes += " legal";

                    if (PlayedFrom == sq.Square)
                        classes += " played-from";

                    if (PlayedTo == sq.Square)
                        classes += " played-to";

                    if (BestFrom == sq.Square)
                        classes += " best-from";

                    if (BestTo == sq.Square)
                        classes += " best-to";

                    <div class="@classes"
                         data-square="@sq.Square"
                         @onclick="() => HandleSquareClick(sq.Square)">
                        @if (sq.Piece != '.')
                        {
                            <img class="piece-img"
                                 src="@ChessBoardHelper.PieceImage(sq.Piece)"
                                 alt=""
                                 draggable="false" />
                        }
                        @if (PlayedTo == sq.Square
                             && MoveBadges.TryGetValue(sq.Square, out var badgeClass)
                             && badgeClass.HasIcon())
                        {
                            <MoveClassificationBadge Classification="badgeClass"
                                                     Variant="board"
                                                     Highlight="@(HighlightBadgeSquare == sq.Square)" />
                        }
                    </div>
                }

                @if (BestArrow is { } arrow)
                {
                    <svg class="move-arrow" viewBox="0 0 8 8" aria-hidden="true">
                        <line x1="@Fmt(arrow.ShaftX1)" y1="@Fmt(arrow.ShaftY1)"
                              x2="@Fmt(arrow.ShaftX2)" y2="@Fmt(arrow.ShaftY2)"
                              stroke="rgba(255, 210, 60, 0.95)" stroke-width="0.22"
                              stroke-linecap="round" />
                        <polygon points="@Fmt(arrow.TipX),@Fmt(arrow.TipY) @Fmt(arrow.Wing1X),@Fmt(arrow.Wing1Y) @Fmt(arrow.Wing2X),@Fmt(arrow.Wing2Y)"
                                 fill="rgba(255, 210, 60, 0.95)"
                                 stroke="rgba(140, 100, 0, 0.85)" stroke-width="0.04"
                                 stroke-linejoin="round" />
                    </svg>
                }
            </div>

            <div class="file-labels">
                @for (var col = 0; col < 8; col++)
                {
                    <span class="coord file-coord">@ChessBoardHelper.FileLabel(col, Flip)</span>
                }
            </div>
        </div>
    </div>

    @if (ShowLegend)
    {
        <div class="board-legend">
            <span class="legend-item"><span class="dot played"></span> сыгранный</span>
            <span class="legend-item"><span class="dot best"></span> лучший</span>
        </div>
    }
</div>

@code {
    [Parameter] public string Fen { get; set; } = BoardState.StartFen;
    [Parameter] public bool Flip { get; set; }
    [Parameter] public string? PlayedUci { get; set; }
    [Parameter] public string? BestUci { get; set; }
    [Parameter] public IReadOnlyDictionary<string, MoveClassification> MoveBadges { get; set; }
        = new Dictionary<string, MoveClassification>();
    [Parameter] public string? HighlightBadgeSquare { get; set; }
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public string? SelectedSquare { get; set; }
    [Parameter] public IReadOnlyList<string> LegalTargets { get; set; } = [];
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public EventCallback<string> OnSquareClick { get; set; }
    [Parameter] public EventCallback<(string From, string To)> OnPieceDrop { get; set; }
    [Parameter] public Func<string, Task<DragStartInfo?>>? QueryDragStart { get; set; }

    private ElementReference _boardRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChessBoard>? _dotNetRef;
    private bool _dragInitialized;
    private bool _lastInteractive;
    private string? PlayedFrom { get; set; }
    private string? PlayedTo { get; set; }
    private string? BestFrom { get; set; }
    private string? BestTo { get; set; }
    private ChessBoardHelper.BestMoveArrow? BestArrow { get; set; }
    private IReadOnlyList<(char Piece, string Square)> Squares { get; set; } = [];

    private bool ShowBestArrow =>
        BestFrom is not null
        && BestTo is not null
        && !string.Equals(PlayedUci, BestUci, StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        var played = ChessBoardHelper.ParseUci(PlayedUci);
        PlayedFrom = played?.From;
        PlayedTo = played?.To;

        var best = ChessBoardHelper.ParseUci(BestUci);
        BestFrom = best?.From;
        BestTo = best?.To;

        Squares = ChessBoardHelper.ParseFen(Fen, Flip);

        BestArrow = ShowBestArrow && BestFrom is not null && BestTo is not null
            ? ChessBoardHelper.BuildBestMoveArrow(BestFrom, BestTo, Flip)
            : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Interactive == _lastInteractive && _dragInitialized == Interactive)
            return;

        _lastInteractive = Interactive;

        if (Interactive)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chess-board.js");
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _boardRef, _dotNetRef);
            _dragInitialized = true;
        }
        else if (_dragInitialized && _module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            _dragInitialized = false;
        }
    }

    [JSInvokable]
    public async Task<DragStartInfo?> HandleDragStartJs(string square)
    {
        if (!Interactive || QueryDragStart is null)
            return null;

        return await QueryDragStart(square);
    }

    [JSInvokable]
    public async Task HandleDropJs(string from, string to)
    {
        if (!Interactive || !OnPieceDrop.HasDelegate)
            return;

        await OnPieceDrop.InvokeAsync((from, to));
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
            }
            catch
            {
            }

            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

    public sealed class DragStartInfo
    {
        public bool CanDrag { get; init; }
        public string[] LegalTargets { get; init; } = [];
    }

    private static string Fmt(double value) =>
        value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task HandleSquareClick(string square)
    {
        if (!Interactive || !OnSquareClick.HasDelegate)
            return;

        await OnSquareClick.InvokeAsync(square);
    }
}
