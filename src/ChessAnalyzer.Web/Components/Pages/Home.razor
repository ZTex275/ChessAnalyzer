@page "/"
@using ChessAnalyzer.Core.Analysis
@using ChessAnalyzer.Core.Chess
@using ChessAnalyzer.Core.ChessCom
@using ChessAnalyzer.Core.Models
@inject ChessComClient ChessCom
@inject GameAnalyzer Analyzer
@inject IJSRuntime JS
@implements IDisposable

<div class="container">
    <h1>Chess Analyzer</h1>
    <p>Анализ партий Chess.com со Stockfish</p>

    <div class="board-section board-first">
        <div class="board-column">
            <ChessBoard Fen="@_board.CurrentFen"
                        Flip="@BoardFlipped"
                        Interactive="@CanInteract"
                        SelectedSquare="@_selectedSquare"
                        LegalTargets="@_legalTargets"
                        PlayedUci="@CurrentPlayedUci"
                        BestUci="@CurrentBestUci"
                        ShowLegend="@(CurrentMoveAnalysis is not null)"
                        OnSquareClick="HandleSquareClick" />

            <div class="board-nav">
                <button @onclick="StepBack" disabled="@(!_board.CanStepBack || _analyzing)">← Назад</button>
                <span class="ply-indicator">@GetPlyLabel()</span>
                <button @onclick="StepForward" disabled="@(!_board.CanStepForward || _analyzing)">Вперёд →</button>
            </div>

            @if (_analyzingMove || _analyzing)
            {
                <div class="progress-wrap">
                    <div class="progress-bar" style="width: @(_progressPercent)%"></div>
                </div>
                <p class="status-text">@_progress · @_progressPercent%</p>
            }
            else if (!string.IsNullOrEmpty(_progress))
            {
                <p class="status-text">@_progress</p>
            }

            @if (CurrentMoveAnalysis is not null)
            {
                <div class="move-detail">
                    <div class="move-header">
                        Ход @CurrentMoveAnalysis.MoveNumber@(CurrentMoveAnalysis.IsWhiteMove ? "." : "...") @CurrentMoveAnalysis.San
                    </div>
                    <strong class="@GetClassCss(CurrentMoveAnalysis.Classification)">
                        @CurrentMoveAnalysis.Classification.ToDisplayName()
                    </strong>
                    <div class="best-move">Лучший: @CurrentMoveAnalysis.BestMoveSan</div>
                    <div>Потеря: @CurrentMoveAnalysis.CentipawnLoss cp</div>
                </div>
            }
        </div>
    </div>

    <div class="picker-section">
        <div class="search-row">
            <input @bind="_username" @bind:event="oninput" placeholder="Логин Chess.com" />
            <button @onclick="LoadGamesAsync" disabled="@_loading">Загрузить</button>
        </div>

        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="status-text">@_status</p>
        }

        @if (_allGames.Count > 0)
        {
            <div class="games-list">
                @foreach (var game in VisibleGames)
                {
                    var outcome = GetOutcome(game);
                    <div class="game-card @(game == _selected ? "selected" : "")"
                         @onclick="() => SelectGame(game)">
                        <div class="game-card-body">
                            <strong>@game.White vs @game.Black</strong>
                            <div class="game-meta">@game.Result · @game.EndTime.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div class="game-outcome @outcome.CssClass" title="@outcome.Title">@outcome.Icon</div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="pagination">
                    <button @onclick="PrevPage" disabled="@(_pageIndex == 0 || _loading)">← Назад</button>
                    <span>@(_pageIndex + 1) / @TotalPages</span>
                    <button @onclick="NextPage" disabled="@(_pageIndex >= TotalPages - 1 || _loading)">Вперёд →</button>
                </div>
            }
        }

        @if (_selected is not null)
        {
            <div class="analysis-panel">
                <h2>@_selected.White vs @_selected.Black</h2>
                <button @onclick="AnalyzeGameAsync" disabled="@(_analyzing || _analyzingMove)">Анализировать партию</button>

                @if (_result is not null)
                {
                    <div class="accuracy-grid">
                        <div class="accuracy-box">
                            Белые
                            <span>@_result.WhiteAccuracy%</span>
                        </div>
                        <div class="accuracy-box">
                            Чёрные
                            <span>@_result.BlackAccuracy%</span>
                        </div>
                    </div>

                    <div class="move-list">
                        @foreach (var row in GetMoveRows())
                        {
                            <div class="move-row">
                                <span class="move-num">@row.Number.</span>
                                @if (row.White is not null)
                                {
                                    <button class="move-btn @ChipClass(row.White.PlyIndex + 1)"
                                            style="border-bottom: 3px solid @row.White.Classification.ToColorHex()"
                                            @onclick="() => GoToMove(row.White!.PlyIndex + 1)">
                                        @row.White.San
                                    </button>
                                }
                                @if (row.Black is not null)
                                {
                                    <button class="move-btn @ChipClass(row.Black.PlyIndex + 1)"
                                            style="border-bottom: 3px solid @row.Black.Classification.ToColorHex()"
                                            @onclick="() => GoToMove(row.Black!.PlyIndex + 1)">
                                        @row.Black.San
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <p class="analysis-time">Время: @_result.AnalysisDuration.ToString(@"mm\:ss")</p>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 5;
    private const string UsernameKey = "chess_username";

    private readonly BoardState _board = new();
    private readonly List<MoveAnalysis?> _moveAnalyses = [];
    private readonly AnalysisOptions _fastOptions = new() { Depth = 12, FastMode = true, Threads = 1, HashMb = 16 };

    private string _username = "";
    private string _status = "";
    private bool _loading;
    private bool _analyzing;
    private bool _analyzingMove;
    private string _progress = "";
    private int _progressPercent;
    private List<ChessComGameSummary> _allGames = [];
    private ChessComGameSummary? _selected;
    private GameAnalysisResult? _result;
    private int _pageIndex;
    private bool _usernameLoaded;
    private string? _selectedSquare;
    private IReadOnlyList<string> _legalTargets = [];
    private int _pgnMoveCount;
    private List<string> _pgnUciMoves = [];

    private CancellationTokenSource? _moveAnalysisCts;

    private bool UserIsBlackInSelectedGame =>
        _selected is not null
        && string.Equals(_selected.Black, _username.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool IsInVariation
    {
        get
        {
            if (_pgnMoveCount == 0)
                return false;

            if (_board.MoveCount != _pgnMoveCount)
                return true;

            for (var i = 0; i < _board.MoveCount; i++)
            {
                if (!string.Equals(_board.Moves[i].Uci, _pgnUciMoves[i], StringComparison.OrdinalIgnoreCase))
                    return true;
            }

            return false;
        }
    }

    private bool CanInteract => !_analyzing;

    private bool BoardFlipped => UserIsBlackInSelectedGame;

    private MoveAnalysis? CurrentMoveAnalysis =>
        _board.CurrentPly > 0 ? GetAnalysisAt(_board.CurrentPly - 1) : null;

    private string? CurrentPlayedUci => CurrentMoveAnalysis?.Uci;
    private string? CurrentBestUci => CurrentMoveAnalysis?.EvalBefore.BestMove;

    private int TotalPages => _allGames.Count == 0 ? 0 : (int)Math.Ceiling(_allGames.Count / (double)PageSize);
    private IEnumerable<ChessComGameSummary> VisibleGames =>
        _allGames.Skip(_pageIndex * PageSize).Take(PageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_usernameLoaded)
        {
            _usernameLoaded = true;
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", UsernameKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                _username = saved;
                StateHasChanged();
            }
        }
    }

    private async Task LoadGamesAsync()
    {
        if (string.IsNullOrWhiteSpace(_username))
        {
            _status = "Укажите логин";
            return;
        }

        var login = _username.Trim();
        _loading = true;
        _status = "Загрузка...";
        _pageIndex = 0;
        _selected = null;
        _result = null;
        ResetBoard();
        _progress = "";
        _progressPercent = 0;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", UsernameKey, login);
            _allGames = (await ChessCom.GetRecentGamesAsync(login, 50)).ToList();
            _status = _allGames.Count == 0
                ? "Партии не найдены"
                : $"Найдено: {_allGames.Count} · страница 1 из {TotalPages}";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _allGames = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetBoard()
    {
        _board.Reset();
        _moveAnalyses.Clear();
        _pgnMoveCount = 0;
        _pgnUciMoves = [];
        ClearSelection();
    }

    private void PrevPage()
    {
        if (_pageIndex > 0)
        {
            _pageIndex--;
            UpdatePageStatus();
        }
    }

    private void NextPage()
    {
        if (_pageIndex < TotalPages - 1)
        {
            _pageIndex++;
            UpdatePageStatus();
        }
    }

    private void UpdatePageStatus()
    {
        if (_allGames.Count > 0)
            _status = $"Найдено: {_allGames.Count} · страница {_pageIndex + 1} из {TotalPages}";
    }

    private void SelectGame(ChessComGameSummary game)
    {
        _selected = game;
        _result = null;
        _progress = "";
        _progressPercent = 0;

        try
        {
            _board.LoadFromPgn(game.Pgn);
            _pgnUciMoves = _board.Moves.Select(m => m.Uci).ToList();
            _pgnMoveCount = _pgnUciMoves.Count;
            _moveAnalyses.Clear();
            ClearSelection();
            _status = $"Партия загружена · {_board.MoveCount} ходов";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            ResetBoard();
        }
    }

    private void StepBack()
    {
        _moveAnalysisCts?.Cancel();
        _analyzingMove = false;
        _board.StepBack();
        ClearSelection();
    }

    private void StepForward()
    {
        _board.StepForward();
        ClearSelection();
    }

    private void GoToMove(int ply)
    {
        _board.GoToPly(ply);
        ClearSelection();
    }

    private string GetPlyLabel()
    {
        if (_board.MoveCount == 0)
            return "Начальная позиция";

        var label = $"Ход {_board.CurrentPly} / {_board.MoveCount}";
        if (IsInVariation)
            label += " · вариант";

        return label;
    }

    private MoveAnalysis? GetAnalysisAt(int moveIndex)
    {
        if (moveIndex < 0 || moveIndex >= _moveAnalyses.Count)
            return null;

        return _moveAnalyses[moveIndex];
    }

    private string ChipClass(int ply) =>
        _board.CurrentPly == ply ? "active" : "";

    private IEnumerable<(int Number, MoveAnalysis? White, MoveAnalysis? Black)> GetMoveRows()
    {
        if (_result is null)
            yield break;

        var maxMove = _result.Moves.Max(m => m.MoveNumber);
        for (var n = 1; n <= maxMove; n++)
        {
            var white = _result.Moves.FirstOrDefault(m => m.MoveNumber == n && m.IsWhiteMove);
            var black = _result.Moves.FirstOrDefault(m => m.MoveNumber == n && !m.IsWhiteMove);
            yield return (n, white, black);
        }
    }

    private async Task HandleSquareClick(string square)
    {
        if (!CanInteract)
            return;

        if (_selectedSquare is null)
        {
            if (_board.IsOwnPiece(square))
            {
                _selectedSquare = square;
                _legalTargets = _board.GetLegalTargetSquares(square);
            }

            return;
        }

        if (square == _selectedSquare)
        {
            ClearSelection();
            return;
        }

        if (_legalTargets.Contains(square))
        {
            var from = _selectedSquare;
            ClearSelection();

            TruncateAnalysesFrom(_board.CurrentPly);

            if (_board.TryMakeMove(from, square))
                await AnalyzeLastMoveAsync();
        }
        else if (_board.IsOwnPiece(square))
        {
            _selectedSquare = square;
            _legalTargets = _board.GetLegalTargetSquares(square);
        }
        else
        {
            ClearSelection();
        }
    }

    private void TruncateAnalysesFrom(int ply)
    {
        while (_moveAnalyses.Count > ply)
            _moveAnalyses.RemoveAt(_moveAnalyses.Count - 1);
    }

    private void ClearSelection()
    {
        _selectedSquare = null;
        _legalTargets = [];
    }

    private async Task AnalyzeLastMoveAsync()
    {
        if (_board.CurrentPly == 0)
            return;

        _moveAnalysisCts?.Cancel();
        _moveAnalysisCts = new CancellationTokenSource();
        var ct = _moveAnalysisCts.Token;

        var moveIndex = _board.CurrentPly - 1;
        var move = _board.GetMoveAt(moveIndex);
        if (move is null)
            return;

        while (_moveAnalyses.Count <= moveIndex)
            _moveAnalyses.Add(null);

        _analyzingMove = true;
        _progress = $"Анализ хода: {move.Value.San}";
        _progressPercent = 0;

        try
        {
            var analysis = await Analyzer.AnalyzeSingleMoveAsync(
                move.Value.San,
                move.Value.Uci,
                _board.GetFenAt(moveIndex),
                _board.GetFenAt(moveIndex + 1),
                move.Value.IsWhite,
                moveIndex,
                _fastOptions,
                ct: ct);

            if (!ct.IsCancellationRequested)
            {
                _moveAnalyses[moveIndex] = analysis;
                _progress = "Готово";
                _progressPercent = 100;
            }
        }
        catch (OperationCanceledException)
        {
            // новый ход отменил предыдущий анализ
        }
        catch (Exception ex)
        {
            _progress = ex.Message;
            _progressPercent = 0;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _analyzingMove = false;
            }
        }
    }

    private async Task AnalyzeGameAsync()
    {
        if (_selected is null)
            return;

        _analyzing = true;
        _progress = "Запуск Stockfish...";
        _progressPercent = 0;
        ClearSelection();

        try
        {
            var progress = new Progress<(int current, int total, string san)>(p =>
            {
                _progressPercent = p.total == 0 ? 0 : (int)Math.Round(p.current * 100.0 / p.total);
                _progress = $"Анализ хода {p.current} из {p.total}: {p.san}";
                _ = InvokeAsync(StateHasChanged);
            });

            _result = await Analyzer.AnalyzeAsync(_selected, _fastOptions, progress);

            _board.LoadFromPgn(_selected.Pgn);
            _pgnUciMoves = _board.Moves.Select(m => m.Uci).ToList();
            _pgnMoveCount = _pgnUciMoves.Count;
            _moveAnalyses.Clear();
            _moveAnalyses.AddRange(_result.Moves.Cast<MoveAnalysis?>());
            _board.GoToPly(0);

            _progress = "Анализ завершён — листайте ходы на доске";
            _progressPercent = 100;
        }
        catch (Exception ex)
        {
            _progress = ex.Message;
            _progressPercent = 0;
        }
        finally
        {
            _analyzing = false;
        }
    }

    private GameOutcome GetOutcome(ChessComGameSummary game)
    {
        var login = _username.Trim();
        if (string.IsNullOrEmpty(login))
            return GameOutcome.Unknown;

        var isWhite = string.Equals(game.White, login, StringComparison.OrdinalIgnoreCase);
        var isBlack = string.Equals(game.Black, login, StringComparison.OrdinalIgnoreCase);

        if (!isWhite && !isBlack)
            return GameOutcome.Unknown;

        if (game.Result == "1/2-1/2")
            return GameOutcome.Draw;

        if (isWhite)
            return game.Result == "1-0" ? GameOutcome.Win : GameOutcome.Loss;

        return game.Result == "0-1" ? GameOutcome.Win : GameOutcome.Loss;
    }

    private static string GetClassCss(MoveClassification c) => c switch
    {
        MoveClassification.Blunder or MoveClassification.Mistake => "classification-blunder",
        MoveClassification.Inaccuracy => "classification-inaccuracy",
        _ => "classification-best"
    };

    public void Dispose()
    {
        _moveAnalysisCts?.Cancel();
        _moveAnalysisCts?.Dispose();
    }

    private readonly record struct GameOutcome(string Icon, string CssClass, string Title)
    {
        public static GameOutcome Win => new("W", "outcome-win", "Победа");
        public static GameOutcome Loss => new("L", "outcome-loss", "Поражение");
        public static GameOutcome Draw => new("D", "outcome-draw", "Ничья");
        public static GameOutcome Unknown => new("·", "outcome-unknown", "");
    }
}
