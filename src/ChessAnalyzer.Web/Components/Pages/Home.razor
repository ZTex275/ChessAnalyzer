@page "/"
@using ChessAnalyzer.Core.Analysis
@using ChessAnalyzer.Core.Chess
@using ChessAnalyzer.Core.ChessCom
@using ChessAnalyzer.Core.Models
@inject ChessComClient ChessCom
@inject GameAnalyzer Analyzer
@inject IJSRuntime JS
@implements IDisposable

<div class="container">
    <h1>Chess Analyzer</h1>
    <p>Анализ партий Chess.com со Stockfish</p>

    <div class="board-section board-first">
        <div class="board-column">
            <ChessBoard Fen="@_board.CurrentFen"
                        Flip="@BoardFlipped"
                        Interactive="@CanInteract"
                        SelectedSquare="@_selectedSquare"
                        LegalTargets="@_legalTargets"
                        PlayedUci="@CurrentPlayedUci"
                        BestUci="@CurrentBestUci"
                        MoveBadges="@VisibleMoveBadges"
                        HighlightBadgeSquare="@CurrentHighlightBadgeSquare"
                        ShowLegend="@(VisibleMoveBadges.Count > 0 || !string.IsNullOrEmpty(CurrentBestUci))"
                        QueryDragStart="QueryDragStart"
                        OnPieceDrop="HandlePieceDrop"
                        OnSquareClick="HandleSquareClick" />

            <div class="board-nav">
                <button @onclick="StepBack" disabled="@(!_board.CanStepBack || _analyzing)">← Назад</button>
                <span class="ply-indicator">@GetPlyLabel()</span>
                <button @onclick="StepForward" disabled="@(!_board.CanStepForward || _analyzing)">Вперёд →</button>
            </div>

            <div class="board-nav board-nav-secondary">
                <button class="btn-flip-board" @onclick="ToggleBoardFlip" title="Перевернуть доску">
                    @(BoardFlipped ? "С белых" : "С чёрных")
                </button>
                <button class="btn-clear-board" @onclick="ClearBoardAndAnalysis" disabled="@(_analyzing || _backgroundAnalyzing)">
                    Очистить
                </button>
            </div>

            @if (IsInVariation)
            {
                <button class="btn-return-main" @onclick="ReturnToMainLine" disabled="@_analyzing">
                    Вернуться в партию
                </button>
            }

            @if (_analyzing || _backgroundAnalyzing)
            {
                <div class="progress-wrap">
                    <div class="progress-bar" style="width: @(_progressPercent)%"></div>
                </div>
                <p class="status-text">@_progress · @_progressPercent%</p>
            }
            else if (!string.IsNullOrEmpty(_progress))
            {
                <p class="status-text">@_progress</p>
            }

            @if (CurrentMoveAnalysis is not null)
            {
                <div class="move-detail">
                    <div class="move-header">
                        Ход @CurrentMoveAnalysis.MoveNumber@(CurrentMoveAnalysis.IsWhiteMove ? "." : "...") @CurrentMoveAnalysis.San
                    </div>
                    <span class="move-classification @CurrentMoveAnalysis.Classification.ToCssClass()">
                        @if (CurrentMoveAnalysis.Classification.HasIcon())
                        {
                            <span class="move-badge">@CurrentMoveAnalysis.Classification.ToIcon()</span>
                        }
                        @CurrentMoveAnalysis.Classification.ToDisplayName()
                    </span>
                    @if (!string.Equals(CurrentMoveAnalysis.Uci, CurrentMoveAnalysis.EvalBefore.BestMove, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="best-move">Лучший был: @CurrentMoveAnalysis.BestMoveSan</div>
                    }
                    <div>Потеря: @CurrentMoveAnalysis.CentipawnLoss cp</div>
                </div>
            }
            else if (!string.IsNullOrEmpty(_positionBestSan))
            {
                <div class="move-detail">
                    <div class="best-move">Лучший ход: @_positionBestSan</div>
                </div>
            }
        </div>
    </div>

    <div class="picker-section">
        <div class="search-row">
            <input @bind="_username" @bind:event="oninput" placeholder="Логин Chess.com" />
            <button @onclick="LoadGamesAsync" disabled="@_loading">Загрузить</button>
        </div>

        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="status-text">@_status</p>
        }

        @if (_allGames.Count > 0)
        {
            <div class="games-list">
                @foreach (var game in VisibleGames)
                {
                    var outcome = GetOutcome(game);
                    <div class="game-card @(game == _selected ? "selected" : "")"
                         @onclick="() => SelectGame(game)">
                        <div class="game-card-body">
                            <strong>@game.White vs @game.Black</strong>
                            <div class="game-meta">@game.Result · @game.EndTime.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div class="game-outcome @outcome.CssClass" title="@outcome.Title">@outcome.Icon</div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="pagination">
                    <button @onclick="PrevPage" disabled="@(_pageIndex == 0 || _loading)">← Назад</button>
                    <span>@(_pageIndex + 1) / @TotalPages</span>
                    <button @onclick="NextPage" disabled="@(_pageIndex >= TotalPages - 1 || _loading)">Вперёд →</button>
                </div>
            }
        }

        @if (_selected is not null)
        {
            <div class="analysis-panel">
                <h2>@_selected.White vs @_selected.Black</h2>
                <div class="analysis-actions">
                    <button @onclick="AnalyzeGameAsync" disabled="@(_analyzing || _backgroundAnalyzing)">Анализировать партию</button>
                    <button class="btn-stop" @onclick="StopAnalysis" disabled="@(!_analyzing)">Остановить</button>
                </div>

                @if (_result is not null)
                {
                    <div class="accuracy-grid">
                        <div class="accuracy-box">
                            Белые
                            <span>@_result.WhiteAccuracy%</span>
                        </div>
                        <div class="accuracy-box">
                            Чёрные
                            <span>@_result.BlackAccuracy%</span>
                        </div>
                    </div>

                    <div class="classification-summary">
                        @foreach (var item in GetClassificationSummary())
                        {
                            <span class="summary-chip @item.Classification.ToCssClass()" title="@item.Classification.ToDisplayName()">
                                @if (item.Classification.HasIcon())
                                {
                                    <span class="move-badge">@item.Classification.ToIcon()</span>
                                }
                                @item.Count
                            </span>
                        }
                    </div>
                }

                @if (_pgnMoveCount > 0)
                {
                    <div class="move-list">
                        @foreach (var row in GetMoveRows())
                        {
                            <div class="move-row">
                                <span class="move-num">@row.Number.</span>
                                @if (row.White is { } whiteMove)
                                {
                                    <button class="move-btn @ChipClass(whiteMove.PlyIndex + 1) @whiteMove.ClassificationCss"
                                            @onclick="() => GoToMove(whiteMove.PlyIndex + 1)">
                                        <span class="move-san">@whiteMove.San</span>
                                        @if (whiteMove.Classification is { } whiteClass && whiteClass.HasIcon())
                                        {
                                            <span class="move-badge">@whiteClass.ToIcon()</span>
                                        }
                                    </button>
                                }
                                @if (row.Black is { } blackMove)
                                {
                                    <button class="move-btn @ChipClass(blackMove.PlyIndex + 1) @blackMove.ClassificationCss"
                                            @onclick="() => GoToMove(blackMove.PlyIndex + 1)">
                                        <span class="move-san">@blackMove.San</span>
                                        @if (blackMove.Classification is { } blackClass && blackClass.HasIcon())
                                        {
                                            <span class="move-badge">@blackClass.ToIcon()</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_result is not null)
                {
                    <p class="analysis-time">Время: @_result.AnalysisDuration.ToString(@"mm\:ss")</p>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 5;
    private const string UsernameKey = "chess_username";

    private readonly BoardState _board = new();
    private readonly List<MoveAnalysis?> _moveAnalyses = [];
    private readonly AnalysisOptions _fastOptions = new() { Depth = 12, FastMode = true, Threads = 1, HashMb = 16 };
    private readonly SemaphoreSlim _analysisLock = new(1, 1);

    private string _username = "";
    private string _status = "";
    private bool _loading;
    private bool _analyzing;
    private bool _backgroundAnalyzing;
    private string _progress = "";
    private int _progressPercent;
    private List<ChessComGameSummary> _allGames = [];
    private ChessComGameSummary? _selected;
    private GameAnalysisResult? _result;
    private int _pageIndex;
    private bool _usernameLoaded;
    private string? _selectedSquare;
    private IReadOnlyList<string> _legalTargets = [];
    private int _pgnMoveCount;
    private List<string> _pgnUciMoves = [];
    private List<(string San, string Uci, bool IsWhite)> _pgnMoves = [];

    private CancellationTokenSource? _gameAnalysisCts;
    private CancellationTokenSource? _backgroundAnalysisCts;
    private CancellationTokenSource? _positionAnalysisCts;
    private EvalCache? _backgroundEvalCache;
    private bool _boardFlipped;
    private string? _positionBestUci;
    private string? _positionBestSan;
    private string _lastPositionFen = "";

    private bool UserIsBlackInSelectedGame =>
        _selected is not null
        && string.Equals(_selected.Black, _username.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool IsInVariation =>
        _board.IsInVariation && _board.CurrentPly > _board.BranchPly;

    private bool CanInteract => !_analyzing;

    private bool BoardFlipped => _boardFlipped;

    private MoveAnalysis? CurrentMoveAnalysis
    {
        get
        {
            if (IsInVariation || _board.CurrentPly == 0)
                return null;

            return GetAnalysisAt(_board.CurrentPly - 1);
        }
    }

    private string? CurrentPlayedUci
    {
        get
        {
            if (_board.CurrentPly == 0)
                return null;

            return CurrentMoveAnalysis?.Uci
                ?? _board.GetMoveAt(_board.CurrentPly - 1)?.Uci;
        }
    }

    private MoveClassification? CurrentMoveClassification =>
        CurrentMoveAnalysis?.Classification;

    private string? CurrentHighlightBadgeSquare =>
        _board.CurrentPly == 0 || IsInVariation
            ? null
            : GetMoveDestinationSquare(_board.CurrentPly - 1);

    private IReadOnlyDictionary<string, MoveClassification> VisibleMoveBadges
    {
        get
        {
            if (_board.CurrentPly == 0 || IsInVariation || _selected is null)
                return EmptyBadges;

            var badges = new Dictionary<string, MoveClassification>();
            for (var i = 0; i < _board.CurrentPly; i++)
            {
                var analysis = GetAnalysisAt(i);
                if (analysis is null || !analysis.Classification.HasIcon())
                    continue;

                var to = GetMoveDestinationSquare(i);
                if (to is not null)
                    badges[to] = analysis.Classification;
            }

            return badges;
        }
    }

    private static readonly IReadOnlyDictionary<string, MoveClassification> EmptyBadges =
        new Dictionary<string, MoveClassification>();

    private string? GetMoveDestinationSquare(int moveIndex)
    {
        var analysis = GetAnalysisAt(moveIndex);
        if (analysis?.Uci.Length >= 4)
            return analysis.Uci[2..4];

        var move = GetMainLineMoveAt(moveIndex);
        if (move?.Uci.Length >= 4)
            return move.Value.Uci[2..4];

        return null;
    }

    private string? CurrentBestUci
    {
        get
        {
            if (CurrentMoveAnalysis is { } m
                && !string.Equals(m.Uci, m.EvalBefore.BestMove, StringComparison.OrdinalIgnoreCase))
                return m.EvalBefore.BestMove;

            return _positionBestUci;
        }
    }

    private int TotalPages => _allGames.Count == 0 ? 0 : (int)Math.Ceiling(_allGames.Count / (double)PageSize);
    private IEnumerable<ChessComGameSummary> VisibleGames =>
        _allGames.Skip(_pageIndex * PageSize).Take(PageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!_usernameLoaded)
            {
                _usernameLoaded = true;
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", UsernameKey);
                if (!string.IsNullOrWhiteSpace(saved))
                {
                    _username = saved;
                    StateHasChanged();
                }
            }

            _ = RefreshPositionBestAsync();
        }
    }

    private async Task LoadGamesAsync()
    {
        if (string.IsNullOrWhiteSpace(_username))
        {
            _status = "Укажите логин";
            return;
        }

        var login = _username.Trim();
        _loading = true;
        _status = "Загрузка...";
        _pageIndex = 0;
        _selected = null;
        _result = null;
        ResetBoard();
        _progress = "";
        _progressPercent = 0;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", UsernameKey, login);
            _allGames = (await ChessCom.GetRecentGamesAsync(login, 50)).ToList();
            _status = _allGames.Count == 0
                ? "Партии не найдены"
                : $"Найдено: {_allGames.Count} · страница 1 из {TotalPages}";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _allGames = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetBoard()
    {
        StopBackgroundAnalysis();
        _board.Reset();
        _moveAnalyses.Clear();
        _pgnMoveCount = 0;
        _pgnUciMoves = [];
        _pgnMoves = [];
        _positionBestUci = null;
        _positionBestSan = null;
        _lastPositionFen = "";
        ClearSelection();
        _ = RefreshPositionBestAsync();
    }

    private void PrevPage()
    {
        if (_pageIndex > 0)
        {
            _pageIndex--;
            UpdatePageStatus();
        }
    }

    private void NextPage()
    {
        if (_pageIndex < TotalPages - 1)
        {
            _pageIndex++;
            UpdatePageStatus();
        }
    }

    private void UpdatePageStatus()
    {
        if (_allGames.Count > 0)
            _status = $"Найдено: {_allGames.Count} · страница {_pageIndex + 1} из {TotalPages}";
    }

    private void SelectGame(ChessComGameSummary game)
    {
        StopBackgroundAnalysis();
        _selected = game;
        _result = null;
        _progress = "";
        _progressPercent = 0;

        try
        {
            _board.LoadFromPgn(game.Pgn);
            _pgnMoves = _board.Moves.Take(_board.MainMoveCount).ToList();
            _pgnUciMoves = _pgnMoves.Select(m => m.Uci).ToList();
            _pgnMoveCount = _pgnUciMoves.Count;
            _moveAnalyses.Clear();
            for (var i = 0; i < _pgnMoveCount; i++)
                _moveAnalyses.Add(null);
            _boardFlipped = UserIsBlackInSelectedGame;
            ClearSelection();
            _board.GoToPly(0);
            _status = $"Партия загружена · {_board.MainMoveCount} ходов";
            _ = RefreshPositionBestAsync();
            _ = AnalyzeAllMovesBackgroundAsync();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            ResetBoard();
        }
    }

    private void ToggleBoardFlip()
    {
        _boardFlipped = !_boardFlipped;
    }

    private void ClearBoardAndAnalysis()
    {
        StopBackgroundAnalysis();
        _gameAnalysisCts?.Cancel();
        _analyzing = false;
        _result = null;
        _progress = "";
        _progressPercent = 0;
        ClearSelection();

        if (_selected is not null)
        {
            try
            {
                _board.LoadFromPgn(_selected.Pgn);
                _pgnMoves = _board.Moves.Take(_board.MainMoveCount).ToList();
                _pgnUciMoves = _pgnMoves.Select(m => m.Uci).ToList();
                _pgnMoveCount = _pgnUciMoves.Count;
                _moveAnalyses.Clear();
                _board.GoToPly(0);
                _boardFlipped = UserIsBlackInSelectedGame;
                _status = "Партия сброшена";
            }
            catch (Exception ex)
            {
                _status = ex.Message;
                ResetBoard();
            }
        }
        else
        {
            ResetBoard();
            _status = "Доска очищена";
        }

        _lastPositionFen = "";
        _ = RefreshPositionBestAsync();
    }

    private void StepBack()
    {
        _board.StepBack();
        ClearSelection();
        _ = RefreshPositionBestAsync();
        _ = EnsureVisibleMoveAnalyzedAsync();
    }

    private void StepForward()
    {
        _board.StepForward();
        ClearSelection();
        _ = RefreshPositionBestAsync();
        _ = EnsureVisibleMoveAnalyzedAsync();
    }

    private void GoToMove(int ply)
    {
        _board.GoToPly(ply);
        ClearSelection();
        _ = RefreshPositionBestAsync();
        _ = EnsureVisibleMoveAnalyzedAsync();
    }

    private void ReturnToMainLine()
    {
        if (!_board.IsInVariation)
            return;

        _board.GoToPly(_board.BranchPly);
        ClearSelection();
        _ = RefreshPositionBestAsync();
    }

    private string GetPlyLabel()
    {
        if (_board.MainMoveCount == 0)
            return "Начальная позиция";

        var label = IsInVariation
            ? $"Вариант · партия {_board.CurrentPly}/{_board.MainMoveCount}"
            : $"Ход {_board.CurrentPly} / {_board.MainMoveCount}";

        return label;
    }

    private MoveAnalysis? GetAnalysisAt(int moveIndex)
    {
        if (moveIndex < 0)
            return null;

        if (_result is not null && moveIndex < _result.Moves.Count)
            return _result.Moves[moveIndex];

        if (moveIndex >= _moveAnalyses.Count)
            return null;

        return _moveAnalyses[moveIndex];
    }

    private string ChipClass(int ply) =>
        _board.CurrentPly == ply ? "active" : "";

    private IEnumerable<(int Number, MoveRowEntry? White, MoveRowEntry? Black)> GetMoveRows()
    {
        var moveCount = _result?.Moves.Count ?? _pgnMoveCount;
        if (moveCount == 0)
            yield break;

        var maxMove = _result is not null
            ? _result.Moves.Max(m => m.MoveNumber)
            : (moveCount + 1) / 2;

        for (var n = 1; n <= maxMove; n++)
        {
            var whiteIdx = (n - 1) * 2;
            var blackIdx = whiteIdx + 1;
            MoveRowEntry? white = whiteIdx < moveCount ? BuildMoveRowEntry(whiteIdx) : null;
            MoveRowEntry? black = blackIdx < moveCount ? BuildMoveRowEntry(blackIdx) : null;
            yield return (n, white, black);
        }
    }

    private MoveRowEntry? BuildMoveRowEntry(int plyIndex)
    {
        var analysis = GetAnalysisAt(plyIndex);
        if (analysis is not null)
        {
            return new MoveRowEntry(
                analysis.San,
                plyIndex,
                analysis.Classification,
                analysis.Classification.ToCssClass());
        }

        var move = GetMainLineMoveAt(plyIndex);
        if (move is null)
            return null;

        return new MoveRowEntry(move.Value.San, plyIndex, null, "");
    }

    private (string San, string Uci, bool IsWhite)? GetMainLineMoveAt(int moveIndex)
    {
        if (moveIndex < 0 || moveIndex >= _pgnMoves.Count)
            return null;

        return _pgnMoves[moveIndex];
    }

    private Task HandlePieceDrop((string From, string To) move)
    {
        if (!CanInteract)
            return Task.CompletedTask;

        ClearSelection();

        if (_board.TryMakeMove(move.From, move.To))
        {
            if (_board.IsOnMainLine)
                _ = EnsureVisibleMoveAnalyzedAsync();
            else
                _ = RefreshPositionBestAsync();
        }

        return Task.CompletedTask;
    }

    private Task<ChessBoard.DragStartInfo?> QueryDragStart(string square)
    {
        if (!CanInteract || !_board.IsOwnPiece(square))
            return Task.FromResult<ChessBoard.DragStartInfo?>(null);

        return Task.FromResult<ChessBoard.DragStartInfo?>(new ChessBoard.DragStartInfo
        {
            CanDrag = true,
            LegalTargets = _board.GetLegalTargetSquares(square).ToArray()
        });
    }

    private Task HandleSquareClick(string square)
    {
        if (!CanInteract)
            return Task.CompletedTask;

        if (_selectedSquare is null)
        {
            if (_board.IsOwnPiece(square))
            {
                _selectedSquare = square;
                _legalTargets = _board.GetLegalTargetSquares(square);
            }

            return Task.CompletedTask;
        }

        if (square == _selectedSquare)
        {
            ClearSelection();
            return Task.CompletedTask;
        }

        if (_legalTargets.Contains(square))
        {
            var from = _selectedSquare;
            ClearSelection();

            if (_board.TryMakeMove(from, square))
            {
                if (_board.IsOnMainLine)
                    _ = EnsureVisibleMoveAnalyzedAsync();
                else
                    _ = RefreshPositionBestAsync();
            }
        }
        else if (_board.IsOwnPiece(square))
        {
            _selectedSquare = square;
            _legalTargets = _board.GetLegalTargetSquares(square);
        }
        else
        {
            ClearSelection();
        }

        return Task.CompletedTask;
    }

    private void ClearSelection()
    {
        _selectedSquare = null;
        _legalTargets = [];
    }

    private async Task EnsureVisibleMoveAnalyzedAsync()
    {
        if (_board.CurrentPly == 0 || !_board.IsOnMainLine || _analyzing)
            return;

        var moveIndex = _board.CurrentPly - 1;
        if (GetAnalysisAt(moveIndex) is not null)
            return;

        var ct = _backgroundAnalysisCts?.Token ?? CancellationToken.None;
        await AnalyzeMoveAtInternalAsync(moveIndex, ct);
        await InvokeAsync(StateHasChanged);
    }

    private void StopBackgroundAnalysis()
    {
        _backgroundAnalysisCts?.Cancel();
        _backgroundAnalysisCts?.Dispose();
        _backgroundAnalysisCts = null;
        _backgroundEvalCache = null;
        _backgroundAnalyzing = false;
    }

    private async Task AnalyzeAllMovesBackgroundAsync()
    {
        if (_pgnMoveCount == 0 || _result is not null)
            return;

        StopBackgroundAnalysis();
        _backgroundAnalysisCts = new CancellationTokenSource();
        var ct = _backgroundAnalysisCts.Token;
        _backgroundEvalCache = new EvalCache();
        _backgroundAnalyzing = true;
        _progress = "Разметка ходов...";
        _progressPercent = 0;

        try
        {
            var analyzed = CountAnalyzedMoves();
            var priorityPly = Math.Max(0, _board.CurrentPly);
            var order = Enumerable.Range(0, _pgnMoveCount)
                .OrderBy(i => i < priorityPly ? 0 : 1)
                .ThenBy(i => i);

            foreach (var i in order)
            {
                ct.ThrowIfCancellationRequested();

                if (GetAnalysisAt(i) is not null)
                    continue;

                await AnalyzeMoveAtInternalAsync(i, ct);

                analyzed++;
                _progressPercent = Math.Min(99, (int)Math.Round(analyzed * 100.0 / _pgnMoveCount));
                _progress = $"Разметка ходов {analyzed}/{_pgnMoveCount}";
                await InvokeAsync(StateHasChanged);
            }

            _progress = "";
            _progressPercent = 0;
        }
        catch (OperationCanceledException)
        {
            _progress = "";
            _progressPercent = 0;
        }
        catch (Exception ex)
        {
            _progress = ex.Message;
            _progressPercent = 0;
        }
        finally
        {
            _backgroundAnalyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int CountAnalyzedMoves()
    {
        var count = 0;
        for (var i = 0; i < _pgnMoveCount; i++)
        {
            if (GetAnalysisAt(i) is not null)
                count++;
        }

        return count;
    }

    private async Task AnalyzeMoveAtInternalAsync(int moveIndex, CancellationToken ct)
    {
        if (moveIndex < 0 || GetAnalysisAt(moveIndex) is not null)
            return;

        var move = GetMainLineMoveAt(moveIndex);
        if (move is null)
            return;

        await _analysisLock.WaitAsync(ct);
        try
        {
            if (GetAnalysisAt(moveIndex) is not null)
                return;

            while (_moveAnalyses.Count <= moveIndex)
                _moveAnalyses.Add(null);

            _backgroundEvalCache ??= new EvalCache();

            var analysis = await Analyzer.AnalyzeSingleMoveAsync(
                move.Value.San,
                move.Value.Uci,
                _board.GetFenAt(moveIndex),
                _board.GetFenAt(moveIndex + 1),
                move.Value.IsWhite,
                moveIndex,
                _fastOptions,
                _backgroundEvalCache,
                ct);

            if (!ct.IsCancellationRequested)
                _moveAnalyses[moveIndex] = analysis;
        }
        finally
        {
            _analysisLock.Release();
        }
    }

    private void StopAnalysis()
    {
        _gameAnalysisCts?.Cancel();
    }

    private async Task AnalyzeGameAsync()
    {
        if (_selected is null)
            return;

        StopBackgroundAnalysis();
        _gameAnalysisCts?.Cancel();
        _gameAnalysisCts?.Dispose();
        _gameAnalysisCts = new CancellationTokenSource();
        var ct = _gameAnalysisCts.Token;

        _analyzing = true;
        _progress = "Запуск Stockfish...";
        _progressPercent = 0;
        ClearSelection();

        try
        {
            var progress = new Progress<(int current, int total, string san)>(p =>
            {
                _progressPercent = p.total == 0
                    ? 0
                    : Math.Min(99, (int)Math.Round(p.current * 100.0 / p.total));
                _progress = $"Анализ хода {p.current} из {p.total}: {p.san}";
                _ = InvokeAsync(StateHasChanged);
            });

            _result = await Analyzer.AnalyzeAsync(_selected, _fastOptions, progress, ct);

            _progress = "Сохранение результата...";
            await InvokeAsync(StateHasChanged);

            _board.LoadFromPgn(_selected.Pgn);
            _pgnMoves = _board.Moves.Take(_board.MainMoveCount).ToList();
            _pgnUciMoves = _pgnMoves.Select(m => m.Uci).ToList();
            _pgnMoveCount = _pgnUciMoves.Count;
            _moveAnalyses.Clear();
            _moveAnalyses.AddRange(_result.Moves.Cast<MoveAnalysis?>());
            _board.GoToPly(0);

            _progress = "Анализ завершён — листайте ходы на доске";
            _progressPercent = 100;
        }
        catch (OperationCanceledException)
        {
            _progress = "Анализ остановлен";
            _progressPercent = 0;
        }
        catch (Exception ex)
        {
            _progress = ex.Message;
            _progressPercent = 0;
        }
        finally
        {
            _analyzing = false;
        }

        if (_result is not null)
            _ = RefreshPositionBestAsync();
    }

    private GameOutcome GetOutcome(ChessComGameSummary game)
    {
        var login = _username.Trim();
        if (string.IsNullOrEmpty(login))
            return GameOutcome.Unknown;

        var isWhite = string.Equals(game.White, login, StringComparison.OrdinalIgnoreCase);
        var isBlack = string.Equals(game.Black, login, StringComparison.OrdinalIgnoreCase);

        if (!isWhite && !isBlack)
            return GameOutcome.Unknown;

        if (game.Result == "1/2-1/2")
            return GameOutcome.Draw;

        if (isWhite)
            return game.Result == "1-0" ? GameOutcome.Win : GameOutcome.Loss;

        return game.Result == "0-1" ? GameOutcome.Win : GameOutcome.Loss;
    }

    private IEnumerable<(MoveClassification Classification, int Count)> GetClassificationSummary()
    {
        if (_result is null)
            yield break;

        var order = new[]
        {
            MoveClassification.Brilliant,
            MoveClassification.Best,
            MoveClassification.Excellent,
            MoveClassification.Good,
            MoveClassification.Book,
            MoveClassification.Inaccuracy,
            MoveClassification.Mistake,
            MoveClassification.Miss,
            MoveClassification.Blunder
        };

        var counts = _result.Moves
            .GroupBy(m => m.Classification)
            .ToDictionary(g => g.Key, g => g.Count());

        foreach (var c in order)
        {
            if (counts.TryGetValue(c, out var count) && count > 0)
                yield return (c, count);
        }
    }

    private async Task RefreshPositionBestAsync()
    {
        if (_analyzing || _backgroundAnalyzing)
            return;

        var fen = _board.CurrentFen;
        if (fen == _lastPositionFen)
            return;

        _positionAnalysisCts?.Cancel();
        _positionAnalysisCts?.Dispose();
        _positionAnalysisCts = new CancellationTokenSource();
        var ct = _positionAnalysisCts.Token;

        try
        {
            var (eval, bestSan) = await Analyzer.AnalyzePositionAsync(fen, _fastOptions, ct);
            if (ct.IsCancellationRequested)
                return;

            _lastPositionFen = fen;
            _positionBestUci = eval.BestMove;
            _positionBestSan = bestSan;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
        }
    }

    public void Dispose()
    {
        StopBackgroundAnalysis();
        _gameAnalysisCts?.Cancel();
        _gameAnalysisCts?.Dispose();
        _positionAnalysisCts?.Cancel();
        _positionAnalysisCts?.Dispose();
    }

